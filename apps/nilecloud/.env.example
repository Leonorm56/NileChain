PM2_APP_NAME="nilecloud"
NODE_ENV="production"
PORT=3000

APP_NAME="NileCloud"
JWT_SECRET_KEY=""

# Primary account ID
PRIMARY_ACCOUNT_ID=

TELEGRAM_BOT_TOKEN=""

# Group configuration - Use -100 prefix for group chat ID
TELEGRAM_CHAT_ID="-100{CHAT_ID}"
TELEGRAM_ANNOUNCEMENT_THREAD_ID=""
TELEGRAM_ERROR_THREAD_ID=""
TELEGRAM_FARMING_THREAD_ID=""

# Group messages configuration
DISPLAY_ACCOUNT_TITLE=false
DISABLE_TELEGRAM_MESSAGES=false

# Captcha Solver configuration (2Captcha / CaptchaAi / SolveCaptcha / CaptchaSonic / NoCaptchaAI)
CAPTCHA_PROVIDER="2captcha" # Options: "2captcha", "captchaai", "solvecaptcha", "captchasonic", "nocaptchaai"
CAPTCHA_API_KEY=""

# Proxy configuration (Webshare)
PROXY_ENABLED=false
PROXY_PROVIDER="webshare" # Options: "webshare", "iplocate"
PROXY_API_KEY=""
PROXY_PLAN_ID=""
PROXY_PAGE=1
PROXY_PAGE_SIZE=100
PROXY_CLEAR_UNSUBSCRIBED=false

# Seeker configuration
SEEKER_ENABLED=false
SEEKER_SERVER=""
SEEKER_KEY=""

# Cron
CRON_ENABLED=true
CRON_MODE="concurrent" # Options: "concurrent", "sequential"

# Startup
STARTUP_SEND_SERVER_ADDRESS=true

# Minimum farmer rating to run (0-5)
MINIMUM_FARMER_RATING=0

# Per farmer configuration
# FARMER_EXAMPLE_ENABLED=true
# FARMER_EXAMPLE_LINK="https://t.me/example_bot/example?start=1234567890"
# FARMER_EXAMPLE_THREAD_ID=""
# FARMER_EXAMPLE_PRIMARY_ACCOUNT_ID=""

# Withdrawal throttle (cloud runner)
# Rate-limits withdrawal *placement* per farmer, fleet-wide, so withdrawals don't all
# go out at once. Regular farming (mining / ads / tasks) stays unthrottled. Wired for SLPY.
# Defaults: 2 withdrawals/hour, spaced by floor(60 / per-hour) minutes (= 30 min at 2/hour).
# FARMER_SLPY_WITHDRAW_PER_HOUR=2
# FARMER_SLPY_WITHDRAW_MIN_GAP_MINUTES=30
# Any other farmer can opt in via FARMER_<ID>_WITHDRAW_PER_HOUR / FARMER_<ID>_WITHDRAW_MIN_GAP_MINUTES.